# .env
PORT=3000
JWT_SECRET=tu_clave_secreta_jwt_muy_segura # ¡Cambia esto por una clave segura real!
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173 # Ajusta según tus necesidades

# Nueva variable para MongoDB
MONGO_URI=mongodb://admin:password123@localhost:27017/akibanet?authSource=admin
# Nota: 'akibanet' será el nombre de tu base de datos.
# 'localhost' funciona si corres la API localmente y el contenedor Docker expone el puerto.
# Si corres la API dentro de Docker (en la misma red), usarías 'mongodb:27017'.